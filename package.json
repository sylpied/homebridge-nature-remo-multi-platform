{
  "displayName": "Homebridge Nature Remo Multi Platform",
  "name": "homebridge-nature-remo-multi-platform",
  "type": "module",
  "version": "2.0.0",
  "description": "Independent Homebridge plugin for multiple Nature Remo devices, lights, air conditioners, TVs and sensors.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sylpied/homebridge-nature-remo-multi-platform.git"
  },
  "bugs": {
    "url": "https://github.com/sylpied/homebridge-nature-remo-multi-platform/issues"
  },
  "homepage": "https://github.com/sylpied/homebridge-nature-remo-multi-platform#readme",
  "private": false,
  "engines": {
    "node": "^22.13.0 || ^24.0.0",
    "homebridge": "^2.0.0"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "homebridge-ui",
    "config.schema.json",
    "README.md",
    "README.ja.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "eslint src --max-warnings=0",
    "watch": "tsc --watch",
    "build": "rimraf ./dist && tsc",
