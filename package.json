    "prepublishOnly": "npm run lint && npm test"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "smart-home",
    "nature",
    "nature-remo"
  ],
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.5",
    "async-mutex": "^0.5.0",
    "axios": "^1.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "homebridge": "^2.2.1",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  }
}
